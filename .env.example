# Application
ASSISTANT_ENVIRONMENT=development
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_LOG_JSON=false
ASSISTANT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ASSISTANT_API_PORT=18000
ASSISTANT_PUBLIC_URL=http://127.0.0.1:18000
ASSISTANT_MEMORY_ENABLED=true
# The default local model is free, Chinese-optimized, and baked into the image.
# Set provider=channel only when the active OpenAI-compatible channel exposes embeddings.
ASSISTANT_MEMORY_EMBEDDING_PROVIDER=local
ASSISTANT_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ASSISTANT_MEMORY_EMBEDDING_CACHE=/opt/fastembed
ASSISTANT_MEMORY_EMBEDDING_LOCAL_FILES_ONLY=true
ASSISTANT_MEMORY_EMBEDDING_THREADS=2
ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_WEB_SEARCH_PROVIDER=ddgs
ASSISTANT_WEB_SEARCH_MAX_RESULTS=6
ASSISTANT_WEB_SEARCH_TIMEOUT_SECONDS=15
ASSISTANT_WEB_FETCH_MAX_BYTES=1500000
ASSISTANT_WEB_FETCH_MAX_CHARS=12000

# Database
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password

# Required security settings
ASSISTANT_ADMIN_USERNAME=admin
ASSISTANT_ADMIN_PASSWORD=change-this-admin-password
ASSISTANT_SECRET_KEY=change-this-application-secret-key
